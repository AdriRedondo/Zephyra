<%- include('en-header', { title: 'Car bookings' , estilos: ['style', 'forms' ],
actual_es: 'es-reservas' ,
actual_en: 'en-bookings' }) %>
<main>
    <section id="Reservations" class="reservas">
        <form id="reservations-form-id" class="formularios reservas-form"
            aria-label="Reservation Form"
            method="post" action="/submit-bookings">
            <div class="mb-3">
                <fieldset class="bookings-fs">
                    <input type="hidden" name="language" value="english">
                    <legend>
                        <h2>Reservation Details</h2>
                    </legend>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label">Full Name:
                                <span
                                    class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" id="name" name="name"
                                    class="form-control"
                                    placeholder="Example: John Doe" required>
                            </div>
                            <span id="name-error" class="error"
                                aria-live="polite"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="email" class="form-label">Email
                                address: <span
                                    class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" id="email" name="email"
                                    class="form-control"
                                    placeholder="Example: john.doe@email.com"
                                    required>
                            </div>
                            <span id="email-error" class="error"
                                aria-live="polite"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="vehicle-selected"
                                class="form-label">Vehicle to Reserve: <span
                                    class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-ev-front"></i>
                                </span>
                                <input type="text" id="vehicle-selected"
                                    class="form-control"
                                    placeholder="Click to select a vehicle"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalVehicles" readonly
                                    required>
                                <input type="hidden" id="vehicle-id"
                                    name="vehicle">
                                <button type="button"
                                    class="btn border-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalVehicles">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <span id="vehicle-error" class="error"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="start" class="form-label">Reservation
                                Start: <span
                                    class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar"></i>
                                </span>
                                <input type="datetime-local" id="start"
                                    name="start" class="form-control">
                            </div>
                            <span id="start-error" class="error"
                                aria-live="polite"></span>

                        </div>
                        <div class="col-md-6">
                            <label for="hours" class="form-label">Reservation
                                Hours: <span
                                    class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-clock"></i>
                                </span>
                                <input type="number" id="hours" name="hours"
                                    class="form-control"
                                    placeholder="Example: 24">
                            </div>
                            <span id="hours-error" class="error"
                                aria-live="polite"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="phone" class="form-label">Contact Phone:
                                <span
                                    class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <input type="tel" id="phone" name="phone"
                                    class="form-control"
                                    placeholder="Example: 123456789">
                            </div>
                            <span id="phone-error" class="error"
                                aria-live="polite"></span>
                        </div>
                        <div class="col-md-12">
                            <label for="terms">Accept Terms and
                                Conditions <span
                                    class="text-danger">*</span></label>
                            <input type="checkbox" id="terms" name="terms"
                                class="form-check-input" required>
                        </div>
                        <div class="col-md-12 progress" role="progressbar"
                            aria-label="Form Progress Bar" aria-valuenow="16.7"
                            aria-valuemin="0"
                            aria-valuemax="100">
                            <div class="progress-bar"></div>
                        </div>
                        <div>
                            <div id="percentage-text">
                                0.0%
                            </div>
                            <div
                                class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="reset"
                                    class="btn border-secondary"
                                    aria-label="Clear form data">
                                    <i class="bi bi-arrow-clockwise me-2"></i>
                                    Clear Data</button>
                                <button type="submit" class="btn border-success"
                                    aria-label="Submit form"> <i
                                        class="bi bi-send me-2"></i> Submit
                                    Reservation</button>
                            </div>

                        </div>
                    </div>
                </fieldset>
            </div>

        </form>
    </section>
</main>
<!-- Vehicle Selection Modal -->
<div class="modal fade" id="modalVehicles" tabindex="-1"
    aria-labelledby="modalVehiclesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalVehiclesLabel">Select
                    Vehicle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Filters in the modal -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label>Make:</label>
                        <select id="filter-make"
                            class="form-select form-select-sm">
                            <option value>All</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Model:</label>
                        <select id="filter-model"
                            class="form-select form-select-sm">
                            <option value>All</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Seats:</label>
                        <select id="filter-seats"
                            class="form-select form-select-sm">
                            <option value>All</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Dealership:</label>
                        <select id="filter-dealership"
                            class="form-select form-select-sm">
                            <option value>All</option>
                        </select>
                    </div>
                </div>

                <!-- Vehicle List -->
                <div id="vehicle-list"
                    class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    <!-- Vehicles will be loaded here from the DB via JS -->
                </div>

                <div id="no-vehicles" class="text-center py-4">
                    <p class="text-muted">No vehicles available with the
                        selected filters</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                    data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<%- include('footer', {scripts: ['formulario-reservas']}) -%>