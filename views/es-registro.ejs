<%- include('es-header', { title: 'Formulario de registro' , estilos: ['style', 'form-registro' ],
    actual_es: 'es-registro' , actual_en: 'en-sign-up' }) %>
    <main>
        <section id="Registro" class="registro">
            <h2>Registro</h2>
            <form id="registro-form-id" class="formularios registro-form" aria-label="Formulario de registro"
                method="post" action="/submit-register">
                <div class="mb-3">
                    <fieldset class="registro-fs">
                        <input type="hidden" name="idioma" value="español">
                        <legend>Datos registro</legend>
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre:
                            </label>
                            <input type="text" id="nombre" name="nombre" class="form-control"
                                placeholder="Ej: Eustaquio Ramirez">
                            <span id="nombre-error" class="error" aria-live="polite"></span>
                        </div>
                        <div class="mb-3">
                            <label for="contraseña" class="form-label">Contraseña:
                            </label>
                            <input type="text" id="contraseña" name="contraseña" class="form-control"
                                placeholder="Ej: ASDFg7&A">
                            <span id="contraseña-error" class="error" aria-live="polite"></span>
                        </div>

                        <button type="submit" class="btn btn-success" aria-label="Enviar formulario">Enviar</button>
                        <button type="reset" class="btn btn-secondary" aria-label="Limpiar formulario">Limpiar</button>
                    </fieldset>
                </div>
            </form>
        </section>
    </main>
    <%- include('footer', {scripts: ['formulario-registro']}) -%>