<%- include('es-header', { title: 'Formulario de login' , estilos: ['style', 'forms' ], actual_es: 'es-login' ,
    actual_en: 'en-login' }) %>
    <main>
        <section id="Login" class="login">
            <form id="login-form-id" class="formularios aria-label=" Formulario de login" method="post"
                action="/submit_login">
                <div class="mb-3">
                    <fieldset class="login-fs" name="login">
                        <input type="hidden" name="idioma" value="español">
                        <legend>
                            <h2>Datos de usuario</h2>
                        </legend>
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="correo" class="form-label">Correo: <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input type="email" id="correo" name="correo" class="form-control" required
                                        placeholder="Ej: eusta03@ucm.es">
                                </div>
                                <span id="correo-error" class="error" aria-live="polite"></span>
                            </div>
                            <div class="col-12">
                                <label for="contraseña" class="form-label">Contraseña: <span
                                        class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i> </span>
                                    <input id="contraseña" name="password" class="form-control" type="password" required
                                        placeholder="Escriba su contraseña">
                                </div>
                                <span id="contraseña-error" class="error" aria-live="polite"></span>
                            </div>
                            <div class="col-12">
                                <label>
                                    Recordar sesión
                                </label>
                                <input type="checkbox" name="recordar" class="form-check-input" value="1">

                            </div>

                            <% if (typeof error !=='undefined' ) { %>
                                <div class="alert alert-danger" role="alert">
                                    <%= error %>
                                </div>
                                <% } %>
                                    <div class="col-12">
                                        <button type="submit" class="btn border-success w-100"
                                            aria-label="Enviar formulario">Login</button>
                                    </div>
                        </div>
                    </fieldset>
                </div>
            </form>
        </section>

    </main>
    <%- include('footer', {scripts: ['formulario-login']}) -%>