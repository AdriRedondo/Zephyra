<%- include('es-header', { title: 'Formulario de login' , estilos: ['style',
'form-login' ], actual_es: 'es-login' ,
actual_en: 'en-login' }) %>
<main>
    <section id="Login" class="login">
        <h2>Login</h2>

        <form id="login-form-id" class="formularios login-form"
            aria-label="Formulario de login" method="post"
            action="/submit_login">
            <div class="mb-3">
                <fieldset class="login-fs" name="login">
                    <input type="hidden" name="idioma" value="español">
                    <legend>Datos de usuario</legend>
                    <div class="mb-3">
                        <label for="correo" class="form-label">Correo:
                        </label>
                        <input type="email" id="correo" name="correo"
                            class="form-control"
                            placeholder="Ej: eusta03@ucm.es">
                        <span id="correo-error" class="error"
                            aria-live="polite"></span>
                    </div>
                    <div class="mb-3">
                        <label for="contraseña" class="form-label">Contraseña:
                        </label>
                        <input id="contraseña" name="password"
                            class="form-control" type="password"
                            placeholder="Escriba su contraseña">
                        <span id="contraseña-error" class="error"
                            aria-live="polite"></span>
                    </div>
                    <div class="mb-3">
                        <label>
                            <input type="checkbox" name="recordar" value="1">
                            Recordar sesión
                        </label>
                    </div>

                    <% if (typeof error !=='undefined' ) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                    <% } %>
                    <button type="submit" class="btn btn-success"
                        aria-label="Enviar formulario">Enviar</button>
                    <button type="reset" class="btn btn-secondary"
                        aria-label="Limpiar formulario">Limpiar</button>
                </fieldset>
            </div>
        </form>
    </section>

</main>
<%- include('footer', {scripts: ['formulario-login']}) -%>