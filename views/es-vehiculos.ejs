<%- include('es-header', { title: 'Vehículos disponibles' , estilos: ['style',
'vehiculos' ], actual_es: 'es-vehiculos'
, actual_en: 'en-vehicles' }) %>
<main>
    <section id="Vehiculos">
        <h2>Vehiculos</h2>
        <table>
            <caption>Vehícluos disponibles</caption>
            <thead>
                <tr>
                    <th scope="col">Matrícula</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Modelo</th>
                    <th scope="col">Autonomía (km)</th>
                </tr>
            </thead>
            <tbody>
                <% if (vehiculos && vehiculos.length > 0) { %>
                <% vehiculos.forEach(function(vehiculo) { %>
                <tr>
                    <td><%= vehiculo.matricula %></td>
                    <td><%= vehiculo.marca %></td>
                    <td><%= vehiculo.modelo %></td>
                    <td><%= vehiculo.autonomia %></td>
                </tr>
                <% }); %>
                <% } else { %>
                <tr>
                    <td colspan="4">No hay vehículos disponibles en este
                        momento.</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>
<%- include('footer', {scripts: []}) -%>