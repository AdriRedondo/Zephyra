<%- include('es-header', {
title: 'Detalle vehiculos',
estilos: ['style', 'vehiculos'],
actual_es: 'es-vehiculos'
}) %>

<main>
    <section id="VehiculoDetalle">
        <h2>Detalles del vehículo</h2>

        <ul>
            <li><strong>Matrícula:</strong> <%= vehiculo.matricula %></li>
            <li><strong>Marca:</strong> <%= vehiculo.marca %></li>
            <li><strong>Modelo:</strong> <%= vehiculo.modelo %></li>
            <li><strong>Autonomía:</strong> <%= vehiculo.autonomia %> km</li>
            <li><strong>Tipo:</strong> <%= vehiculo.tipo %></li>
        </ul>

        <a href="/es-vehiculos">← Volver a la lista</a>
    </section>
</main>

<%- include('footer', {scripts: []}) %>
