<%- include('es-header', { title: 'Detalle vehículo' , estilos: ['style' ], actual_es: 'es-vehiculo-detalles' ,
    actual_en: 'en-vehicle-details' , extraCSS: vehiculo.latitud ? ['https://unpkg.com/leaflet@1.9.4/dist/leaflet.css']
    : [] }) %>

    <main>
        <section id="vehiculoDetalles" class="row justify-content-center">
            <div class="container-vehiculo col-md-8 m-0 mb-3">
                <h2>
                    <%= vehiculo.marca %>
                        <%= vehiculo.modelo %>
                </h2>

                <img src="/es-vehiculos/imagen/<%= vehiculo.id_vehiculo %>" class="card-img-top"
                    style="max-width: 800px; width: 100%; display: block; margin: 0 auto;"
                    alt="<%= vehiculo.marca %> <%= vehiculo.modelo %>" onerror="this.src='/images/unknown.png'">

                <div>
                    <div class="row">
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Matrícula:</strong>
                                <%= vehiculo.matricula %>
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Número de plazas:</strong>
                                <%= vehiculo.numero_plazas %>
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p><strong>Autonomía:</strong>
                                <%= vehiculo.autonomia_km %> km
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Color:</strong>
                                <%= vehiculo.color %>
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p><strong>Año de matriculación:</strong>
                                <%= vehiculo.anyo_matriculacion %>
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Estado:</strong>
                                <%= vehiculo.estado %>
                            </p>
                        </div>

                        <div class="col">
                            <p><strong>Concesionario:</strong>
                                <%= vehiculo.nombre_concesionario %>
                            </p>
                        </div>
                        <!-- Mapa del concesionario -->
                        <% if (vehiculo.latitud && vehiculo.longitud) { %>
                            <div class="col-12 mt-3">
                                <h5><i class="bi bi-geo-alt-fill text-success me-2"></i>Ubicación del concesionario</h5>
                                <p class="text-muted small mb-1">
                                    <%= vehiculo.nombre_concesionario %> · <%= vehiculo.ciudad_concesionario %>
                                </p>
                                <div id="mapa-concesionario" style="height: 250px; border-radius: 8px;"></div>
                            </div>
                            <% } %>
                                <!-- Valoraciones del vehículo -->
                                <div class="container mt-4">
                                    <h4><i class="bi bi-star text-warning me-2"></i>Valoraciones</h4>
                                    <div id="seccion-valoraciones">
                                        <p class="text-muted">Cargando valoraciones...</p>
                                    </div>
                                </div>
                                <% if(usuario && usuario.rol==='admin' ) { %>
                                    <div class="d-flex gap-2 mt-3">
                                        <div class="col-6">
                                            <a class="btn border-secondary w-100"
                                                href="/es-vehiculos/<%= vehiculo.id_vehiculo %>/editar">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>
                                        </div>
                                        <div class="col-6">
                                            <form action="/es-vehiculos/<%= vehiculo.id_vehiculo %>/eliminar"
                                                method="post"
                                                onsubmit="return confirm('¿Estás seguro de eliminar este vehículo?');">
                                                <button class="btn border-danger w-100" type="submit">
                                                    <i class="bi bi-trash-fill"></i> Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <% } %>

                    </div>
                </div>
            </div>

        </section>

        <script>
            fetch('/api/vehiculos/<%= vehiculo.id_vehiculo %>/valoraciones')
                .then(res => res.json())
                .then(data => {
                    const contenedor = document.getElementById('seccion-valoraciones');
                    if (!data.success || data.data.total_valoraciones === 0) {
                        contenedor.innerHTML = '<p class="text-muted">Este vehículo aún no tiene valoraciones.</p>';
                        return;
                    }
                    const d = data.data;
                    const estrellasFill = Math.round(d.media);
                    contenedor.innerHTML = `
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="display-5 fw-bold text-warning">${d.media}</span>
        <div>
            <div class="text-warning fs-4">
                ${[1, 2, 3, 4, 5].map(i =>
                        `<i class="bi bi-star${i <= estrellasFill ? '-fill' : ''}"></i>`
                    ).join('')}
            </div>
            <small class="text-muted">${d.total_valoraciones} valoracion${d.total_valoraciones !== 1 ? 'es' : ''}</small>
        </div>
    </div>
    ${[5, 4, 3, 2, 1].map(n => {
                        const count = d[`estrellas_${n}`] || 0;
                        const pct = d.total_valoraciones > 0 ? Math.round((count / d.total_valoraciones) * 100) : 0;
                        return `
    <div class="d-flex align-items-center gap-2 mb-1">
        <span style="width:60px">${n} <i class="bi bi-star-fill text-warning"></i></span>
        <div class="progress flex-grow-1" style="height:12px">
            <div class="progress-bar bg-warning" style="width:${pct}%"></div>
        </div>
        <span style="width:35px" class="text-muted small">${count}</span>
    </div>`;
                    }).join('')}
    <div id="lista-comentarios" class="mt-4">
        <p class="text-muted small">Cargando comentarios...</p>
    </div>
    `;

                    fetch('/api/vehiculos/<%= vehiculo.id_vehiculo %>/comentarios')
                        .then(r => r.json())
                        .then(resp => {
                            const lista = document.getElementById('lista-comentarios');
                            if (!resp.success || resp.data.length === 0) {
                                lista.innerHTML = '<p class="text-muted small">Sin comentarios escritos aún.</p>';
                                return;
                            }
                            lista.innerHTML = '<h6 class="mb-3">Comentarios</h6>' +
                                resp.data.map(c => {
                                    const estrellas = [1, 2, 3, 4, 5].map(i =>
                                        `<i class="bi bi-star${i <= c.puntuacion ? '-fill' : ''} text-warning"></i>`
                                    ).join('');
                                    const fecha = new Date(c.fecha_fin).toLocaleDateString('es-ES');
                                    return `
    <div class="border rounded p-3 mb-2">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <div>${estrellas}</div>
            <small class="text-muted">${fecha}</small>
        </div>
        <p class="mb-1 small">${c.comentario}</p>
        <small class="text-muted fst-italic">${c.nombre_cliente || 'Cliente anónimo'}</small>
    </div>`;
                                }).join('');
                        })
                        .catch(() => {
                            const lista = document.getElementById('lista-comentarios');
                            if (lista) lista.innerHTML = '';
                        });
                })
                .catch(() => {
                    document.getElementById('seccion-valoraciones').innerHTML =
                        '<p class="text-muted">No se pudieron cargar las valoraciones.</p>';
                });
        </script>
    </main>
    <% if (vehiculo.latitud && vehiculo.longitud) { %>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            const map = L.map('mapa-concesionario').setView(["<%= vehiculo.latitud %>", "<%= vehiculo.longitud %>"], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);
            L.marker(["<%= vehiculo.latitud %>", "<%= vehiculo.longitud %>"])
                .addTo(map)
                .bindPopup('<strong><%= vehiculo.nombre_concesionario %></strong><br><%= vehiculo.direccion_concesionario %>')
                .openPopup();
        </script>
        <% } %>
            <%- include('footer', {scripts: [ 'admin-ajax' ]}) %>