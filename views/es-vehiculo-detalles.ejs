<%- include('es-header', { title: 'Detalle vehículo' , estilos: ['style', 'detalles-vehiculo' ],
    actual_es: 'es-vehiculo-detalles' , actual_en: 'en-vehicle-details' } ) %>

    <main>
        <section id="vehiculoDetalles" class="row justify-content-center">
            <div class="container-vehiculo col-md-8 m-0 mb-3">
                <h2>
                    <%= vehiculo.marca %>
                        <%= vehiculo.modelo %>
                </h2>

                <img src="/es-vehiculos/imagen/<%= vehiculo.id_vehiculo %>" class="card-img-top"
                    alt="<%= vehiculo.marca %> <%= vehiculo.modelo %>"
                    onerror="this.src='/img/vehiculo-placeholder.jpg'">

                <div>
                    <div class="row">
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Matrícula:</strong>
                                <%= vehiculo.matricula %>
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Número de plazas:</strong>
                                <%= vehiculo.numero_plazas %>
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p><strong>Autonomía:</strong>
                                <%= vehiculo.autonomia_km %> km
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Color:</strong>
                                <%= vehiculo.color %>
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p><strong>Año de matriculación:</strong>
                                <%= vehiculo.anyo_matriculacion %>
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <p><strong>Estado:</strong>
                                <%= vehiculo.estado %>
                            </p>
                        </div>

                        <div class="col">
                            <p><strong>Concesionario:</strong>
                                <%= vehiculo.nombre_concesionario %>
                            </p>
                        </div>

                        <% if(usuario && usuario.rol==='admin' ) { %>
                            <div class="d-flex gap-2 mt-3">
                                <div class="col-6">
                                    <a class="btn border-secondary w-100"
                                        href="/es-vehiculos/<%= vehiculo.id_vehiculo %>/editar">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                </div>
                                <div class="col-6">
                                    <form action="/es-vehiculos/<%= vehiculo.id_vehiculo %>/eliminar" method="post"
                                        onsubmit="return confirm('¿Estás seguro de eliminar este vehículo?');">
                                        <button class="btn border-danger w-100" type="submit">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <% } %>
                    </div>
                </div>
        </section>
    </main>

    <%- include('footer', {scripts: [ 'admin-ajax' ]}) %>