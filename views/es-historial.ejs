<%- include('es-header', { title: 'Historial de Reservas', estilos: ['style'], actual_es: 'es-historial', actual_en: 'en-history' }) %>

<main class="container my-5">
    <h2 class="mb-4">Mi Historial de Reservas</h2>

    <!-- Reservas Activas -->
    <section class="mb-5">
        <h3 class="mb-3">Reservas Activas</h3>
        <% if (reservasActivas.length === 0) { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No tienes reservas activas en este momento.
            </div>
        <% } else { %>
            <div class="row">
                <% reservasActivas.forEach(reserva => { %>
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <% if (reserva.imagen) { %>
                                <img src="data:image/jpeg;base64,<%= reserva.imagen.toString('base64') %>"
                                     class="card-img-top"
                                     alt="<%= reserva.marca %> <%= reserva.modelo %>"
                                     style="height: 200px; object-fit: cover;">
                            <% } else { %>
                                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                     style="height: 200px;">
                                    <i class="bi bi-car-front-fill text-white" style="font-size: 3rem;"></i>
                                </div>
                            <% } %>
                            <div class="card-body">
                                <h5 class="card-title"><%= reserva.marca %> <%= reserva.modelo %></h5>
                                <p class="card-text">
                                    <strong>Matrícula:</strong> <%= reserva.matricula %><br>
                                    <strong>Fecha inicio:</strong> <%= new Date(reserva.fecha_inicio).toLocaleString('es-ES') %><br>
                                    <strong>Fecha fin:</strong> <%= new Date(reserva.fecha_fin).toLocaleString('es-ES') %>
                                </p>
                                <span class="badge bg-success">Activa</span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>

    <!-- Reservas Finalizadas -->
    <section>
        <h3 class="mb-3">Historial de Reservas Finalizadas</h3>
        <% if (reservasFinalizadas.length === 0) { %>
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No tienes reservas finalizadas todavía.
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Vehículo</th>
                            <th>Matrícula</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Estado</th>
                            <th>Kilómetros</th>
                            <th>Incidencias</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reservasFinalizadas.forEach(reserva => { %>
                            <tr>
                                <td><%= reserva.marca %> <%= reserva.modelo %></td>
                                <td><%= reserva.matricula %></td>
                                <td><%= new Date(reserva.fecha_inicio).toLocaleDateString('es-ES') %></td>
                                <td><%= new Date(reserva.fecha_fin).toLocaleDateString('es-ES') %></td>
                                <td>
                                    <% if (reserva.estado === 'finalizada') { %>
                                        <span class="badge bg-secondary">Finalizada</span>
                                    <% } else if (reserva.estado === 'cancelada') { %>
                                        <span class="badge bg-danger">Cancelada</span>
                                    <% } %>
                                </td>
                                <td><%= reserva.kilometros_recorridos || 'N/A' %></td>
                                <td>
                                    <% if (reserva.incidencias_reportadas) { %>
                                        <button class="btn btn-sm btn-outline-info"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#incidencia-<%= reserva.id_reserva %>">
                                            Ver
                                        </button>
                                        <div class="collapse mt-2" id="incidencia-<%= reserva.id_reserva %>">
                                            <div class="card card-body">
                                                <%= reserva.incidencias_reportadas %>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        Ninguna
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <div class="mt-4">
        <a href="/es-inicio" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver al inicio
        </a>
        <a href="/es-reservas" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva reserva
        </a>
    </div>
</main>

<%- include('footer', { scripts: ['bootstrap.bundle.min'] }) %>
