<%- include('es-header', { title: 'Historial de Reservas' , estilos: ['style', 'admin-sections' ],
    actual_es: 'es-historial' , actual_en: 'en-history' }) %>

    <main class="container my-5">
        <h2 class="mb-4">Mi Historial de Reservas</h2>

        <!-- Reservas Activas -->
        <section class="mb-5">
            <h3 class="mb-3">Reservas Activas</h3>
            <% if (reservasActivas.length===0) { %>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No tienes reservas activas en este momento.
                </div>
                <% } else { %>
                    <div class="row">
                        <% reservasActivas.forEach(reserva=> { %>
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <% if (reserva.imagen) { %>
                                        <img src="data:image/jpeg;base64,<%= reserva.imagen.toString('base64') %>"
                                            class="card-img-top" alt="<%= reserva.marca %> <%= reserva.modelo %>"
                                            style="height: 200px; object-fit: cover;">
                                        <% } else { %>
                                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                                style="height: 200px;">
                                                <i class="bi bi-car-front-fill text-white" style="font-size: 3rem;"></i>
                                            </div>
                                            <% } %>
                                                <div class="card-body">
                                                    <h5 class="card-title">
                                                        <%= reserva.marca %>
                                                            <%= reserva.modelo %>
                                                    </h5>
                                                    <p class="card-text">
                                                        <strong>Matrícula:</strong>
                                                        <%= reserva.matricula %><br>
                                                            <strong>Fecha inicio:</strong>
                                                            <%= new Date(reserva.fecha_inicio).toLocaleString('es-ES')
                                                                %><br>
                                                                <strong>Fecha fin:</strong>
                                                                <%= new Date(reserva.fecha_fin).toLocaleString('es-ES')
                                                                    %>
                                                    </p>
                                                    <span class="badge bg-success">Activa</span>
                                                </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </section>

        <!-- Reservas Finalizadas -->
        <section>
            <h3 class="mb-3">Historial de Reservas Finalizadas</h3>
            <% if (reservasFinalizadas.length===0) { %>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No tienes reservas finalizadas todavía.
                </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Vehículo</th>
                                    <th>Matrícula</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Estado</th>
                                    <th>Kilómetros</th>
                                    <th>Incidencias</th>
                                    <th>Valoración</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reservasFinalizadas.forEach(reserva=> { %>
                                    <tr>
                                        <td>
                                            <%= reserva.marca %>
                                                <%= reserva.modelo %>
                                        </td>
                                        <td>
                                            <%= reserva.matricula %>
                                        </td>
                                        <td>
                                            <%= new Date(reserva.fecha_inicio).toLocaleDateString('es-ES') %>
                                        </td>
                                        <td>
                                            <%= new Date(reserva.fecha_fin).toLocaleDateString('es-ES') %>
                                        </td>
                                        <td>
                                            <% if (reserva.estado==='finalizada' ) { %>
                                                <span class="badge bg-secondary">Finalizada</span>
                                                <% } else if (reserva.estado==='cancelada' ) { %>
                                                    <span class="badge bg-danger">Cancelada</span>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= reserva.kilometros_recorridos || 'N/A' %>
                                        </td>
                                        <td>
                                            <% if (reserva.incidencias_reportadas) { %>
                                                <button class="btn btn-sm btn-outline-success" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#incidencia-<%= reserva.id_reserva %>">
                                                    Ver
                                                </button>
                                                <div class="collapse mt-2" id="incidencia-<%= reserva.id_reserva %>">
                                                    <div class="card card-body">
                                                        <%= reserva.incidencias_reportadas %>
                                                    </div>
                                                </div>
                                                <% } else { %>
                                                    Ninguna
                                                    <% } %>
                                        </td>
                                        <td>
                                            <% if (reserva.estado==='finalizada' ) { %>
                                                <% if (reserva.puntuacion) { %>
                                                    <span class="text-warning">
                                                        <% for(let i=1; i <=5; i++) { %>
                                                            <i
                                                                class="bi bi-star<%= i <= reserva.puntuacion ? '-fill' : '' %>"></i>
                                                            <% } %>
                                                    </span>
                                                    <% } else { %>
                                                        <button class="btn btn-sm border-success"
                                                            onclick="abrirModalValorar('<%= reserva.id_reserva %>', '<%= reserva.marca %> <%= reserva.modelo %>')">
                                                            <i class="bi bi-star me-1"></i> Valorar
                                                        </button>
                                                        <% } %>
                                                            <% } else { %>
                                                                —
                                                                <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
        </section>

        <div class="mt-4">
            <!-- Botones de navegación -->
            <div class="mt-4 d-flex flex-column flex-sm-row gap-2">
                <a href="/es-inicio" class="btn border-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i>Volver al inicio
                </a>
                <a href="/es-reservas" class="btn border-success px-4">
                    <i class="bi bi-plus-circle me-2"></i>Nueva reserva
                </a>
            </div>
        </div>

    </main>
    <!-- Modal de valoración -->
    <div class="modal fade" id="modalValorar" tabindex="-1" aria-labelledby="modalValorarLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalValorarLabel">Valorar reserva</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="modal-vehiculo-nombre" class="text-muted mb-3"></p>

                    <label class="form-label fw-bold">Puntuación:</label>
                    <div class="d-flex gap-2 mb-3" id="estrellas-selector">
                        <% for(let i=1; i <=5; i++) { %>
                            <i class="bi bi-star fs-3 text-warning estrella-btn" style="cursor:pointer"
                                data-valor="<%= i %>"></i>
                            <% } %>
                    </div>
                    <input type="hidden" id="puntuacion-seleccionada" value="">

                    <label for="comentario-valoracion" class="form-label fw-bold">Comentario (opcional):</label>
                    <textarea id="comentario-valoracion" class="form-control" rows="3"
                        placeholder="Cuéntanos tu experiencia con este vehículo..."></textarea>

                    <div id="valorar-error" class="text-danger mt-2" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn border-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn border-success" id="btn-enviar-valoracion">
                        <i class="bi bi-send me-1"></i> Enviar valoración
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let reservaIdActual = null;

        function abrirModalValorar(idReserva, nombreVehiculo) {
            reservaIdActual = idReserva;
            document.getElementById('modal-vehiculo-nombre').textContent = nombreVehiculo;
            document.getElementById('puntuacion-seleccionada').value = '';
            document.getElementById('comentario-valoracion').value = '';
            document.getElementById('valorar-error').style.display = 'none';

            // Resetear estrellas
            document.querySelectorAll('.estrella-btn').forEach(e => {
                e.classList.remove('bi-star-fill');
                e.classList.add('bi-star');
            });

            new bootstrap.Modal(document.getElementById('modalValorar')).show();
        }

        // Selección de estrellas
        document.querySelectorAll('.estrella-btn').forEach(estrella => {
            estrella.addEventListener('click', () => {
                const valor = parseInt(estrella.dataset.valor);
                document.getElementById('puntuacion-seleccionada').value = valor;
                document.querySelectorAll('.estrella-btn').forEach((e, i) => {
                    e.classList.toggle('bi-star-fill', i < valor);
                    e.classList.toggle('bi-star', i >= valor);
                });
            });
        });

        // Enviar valoración
        document.getElementById('btn-enviar-valoracion').addEventListener('click', () => {
            const puntuacion = document.getElementById('puntuacion-seleccionada').value;
            const comentario = document.getElementById('comentario-valoracion').value;
            const errorDiv = document.getElementById('valorar-error');

            if (!puntuacion) {
                errorDiv.textContent = 'Debes seleccionar una puntuación';
                errorDiv.style.display = 'block';
                return;
            }

            fetch(`/api/reservas/${reservaIdActual}/valorar`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ puntuacion, comentario })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modalValorar')).hide();
                        location.reload();
                    } else {
                        errorDiv.textContent = data.message;
                        errorDiv.style.display = 'block';
                    }
                })
                .catch(() => {
                    errorDiv.textContent = 'Error al enviar la valoración';
                    errorDiv.style.display = 'block';
                });
        });
    </script>
    <%- include('footer', { scripts: [] }) %>