<%- include('en-header', { title: 'Login form' , estilos: ['style', 'form-login' ], actual_es: 'es-login' ,
    actual_en: 'en-login' }) %>
    <main>
        <section id="Login" class="login">
            <h2>Login</h2>
            <form id="login-form-id" class="login-form" aria-label="Login form" method="post" action="/submit_login">
                <div class="mb-3">
                    <fieldset class="contact-fs" name="contacto">
                        <input type="hidden" name="idioma" value="english">
                        <legend>User information</legend>
                        <div class="mb-3">
                            <label for="correo" class="form-label">Email:
                            </label>
                            <input type="email" id="correo" name="correo" class="form-control"
                                placeholder="Ex: eusta03@ucm.es">
                            <span id="correo-error" class="error" aria-live="polite"></span>
                        </div>
                        <div class="mb-3">
                            <label for="contraseña" class="form-label">Password:
                            </label>
                            <input id="contraseña" name="contraseña" class="form-control" type="password"
                                placeholder="Write your password">
                            <span id="contraseña-error" class="error" aria-live="polite"></span>
                        </div>
                        <button type="submit" class="btn btn-success" aria-label="Submit form">Submit</button>
                        <button type="reset" class="btn btn-secondary" aria-label="Clear form">Clear</button>
                    </fieldset>
                </div>
            </form>
        </section>

    </main>
    <%- include('footer', {scripts: ['formulario-login']}) -%>