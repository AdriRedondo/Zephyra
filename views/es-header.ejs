<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="./styles/bootstrap.min.css">
    <% estilos.forEach(estilo=> { %>
        <link rel="stylesheet" href="./styles/<%= estilo %>.css">
        <% }) %>


</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <button class="navbar-toggler ms-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand div-logo" href="/es-inicio">
                    <img src=" ./images/icono-logo.png" alt="Logo Zephyra" title="Logo Zephyra" width="100">
                    <h1 class="zephyra">ZEPHYRA</h1>
                </a>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ">
                        <li class="nav-item me-2"><a class="nav-link elem-menu p-2" href="/es-inicio"
                                accesskey="i">Inicio</a>
                        </li>
                        <li class="nav-item me-2"><a class="nav-link elem-menu p-2" href="/es-vehiculos"
                                accesskey="v">Vehículos</a>
                        </li>
                        <li class="nav-item me-2"><a class="nav-link elem-menu p-2" href="/es-reservas"
                                accesskey="r">Reservas</a>
                        </li>
                        <li class="nav-item me-2"><a class="nav-link elem-menu p-2" href="/es-contacto"
                                accesskey="c">Contacto</a>
                        </li>
                        <li class="nav-item me-2"><a class="nav-link elem-menu p-2" href="/es-registro"
                                accesskey="g">Registro</a>
                        </li>
                        <li class="nav-item dropdown me-2">
                            <a class="dropdown-toggle nav-link elem-menu" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                Cambiar idioma
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="./<%= actual_en %>" lang="es" title="Cambiar a Inglés"
                                        class="dropdown-item">
                                        Inglés (EN)
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>

            </div>

        </nav>

    </header>