<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="./styles/bootstrap.min.css">
    <% estilos.forEach(estilo=> { %>
        <link rel="stylesheet" href="./styles/<%= estilo %>.css">
        <% }) %>


</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <button class="navbar-toggler ms-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand div-logo" href="/es-inicio">
                    <img src=" ./images/icono-logo.png" alt="Logo Zephyra" title="Logo Zephyra" width="100">
                    <h1 class="zephyra">ZEPHYRA</h1>
                </a>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ">
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="/es-inicio" accesskey="i">Inicio</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="/es-vehiculos" accesskey="v">Vehículos</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="/es-reservas" accesskey="r">Reservas</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="/es-contacto" accesskey="c">Contacto</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="/es-registro" accesskey="g">Registro</a>
                        </li>
                        <li class="nav-item me-2">
                            <a role="button" class="nav-link elem-menu p-2" accesskey="a" data-bs-toggle="modal"
                                data-bs-target="#accessModal">Accesibilidad</a>
                        </li>
                        <div class="modal fade" id="accessModal" tabindex="-1" aria-labelledby="accessModalLabel"
                            aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="accessModalLabel">Accesibilidad</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <ul class="list-group">
                                            <li class="list-group-item">
                                                <a href="#">Inicio</a>
                                            </li>
                                            <li class="list-group-item">
                                                <a href="#">Vehículos</a>
                                            </li>
                                            <li class="list-group-item">
                                                <a href="#">Reservas</a>
                                            </li>
                                            <li class="list-group-item">
                                                <a href="#">Contacto</a>
                                            </li>
                                            <li class="list-group-item dropdown w-100">
                                                <a class="dropdown-toggle nav-link" href="#"
                                                    data-bs-toggle="dropdown">Cambiar idioma</a>
                                                <ul class="dropdown-menu">
                                                    <li><a href="./<%= actual_en %>" class="dropdown-item">Inglés
                                                            (EN)</a></li>
                                                    <li><a href="/es-inicio" class="dropdown-item">Español (ES)</a></li>
                                                </ul>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">Cerrar</button>
                                        <button type="button" class="btn btn-success">Guardar cambios</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </ul>
                </div>

            </div>

        </nav>

    </header>