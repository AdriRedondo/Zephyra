<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <% estilos.forEach(estilo=> { %>
        <link rel="stylesheet" href="/styles/<%= estilo %>.css">
        <% }) %>
            <script>
                // Aplicar tema lo antes posible, antes de que cargue el CSS
                const theme = localStorage.getItem('theme');
                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                };
            </script>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark" id="custom-navbar">
            <div class="container-fluid ">
                <button class="navbar-toggler ms-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="logo-container">
                    <a class="navbar-brand div-logo" href="/es-inicio">
                        <img src="/images/icono-logo.png" alt="Logo Zephyra" title="Logo Zephyra" width="100">
                        <h1 class="zephyra">ZEPHYRA</h1>
                    </a>
                </div>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/es-inicio" accesskey="i">Inicio</a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/es-vehiculos" accesskey="v">Vehículos</a>
                        </li>
                        <% if(usuario) {%>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/es-reservas" accesskey="r">Reservar vehículo</a>
                            </li>
                            <% } %>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <% if(usuario) {%>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/es-historial" accesskey="h">Mis Reservas</a>
                            </li>
                            <% } %>
                                <% if(!usuario) {%>
                                    <li class="nav-item me-3">
                                        <a class="nav-link pt-auto" href="/es-login" accesskey="l">Login</a>
                                    </li>
                                    <% } %>
                                        <li class="nav-item me-3">
                                            <a role="button" class="nav-link pt-auto" accesskey="a"
                                                data-bs-toggle="modal" data-bs-target="#accessModal">Accesibilidad</a>
                                        </li>
                                        <% if(usuario && usuario.rol==='admin' ) {%>
                                            <li class="nav-item me-3">
                                                <a class="nav-link pt-auto" href="/es-admin"
                                                    accesskey="m">Administrador</a>
                                            </li>
                                            <% } %>
                                                <% if(usuario) {%>
                                                    <li class="nav-item me-3">
                                                        <a class="menu-icon nav-link" href="/es-logout" accesskey="g">
                                                            <i class="bi bi-box-arrow-left"></i>
                                                        </a>
                                                    </li>
                                                    <% }%>
                                                        <% if(usuario) {%>
                                                            <li class="nav-item">
                                                                <a class="menu-icon nav-link" href="/es-perfil"
                                                                    accesskey="p">
                                                                    <i class="profile-icon bi bi-person-circle"></i>
                                                                </a>
                                                            </li>
                                                            <% } %>
                </div>

            </div>

        </nav>

    </header>
    <!-- Modal de Accesibilidad -->
    <div class="modal fade" id="accessModal" tabindex="-1" aria-labelledby="accessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="accessModalLabel">Accesibilidad</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-group">
                        <h5>Contraste</h5>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="btn-group w-100">
                                <button id="light-btn" class="btn border-success">Claro</button>
                                <button id="dark-btn" class="btn border-success">Oscuro</button>
                            </div>
                        </li>

                        <h5>Tamaño de fuente</h5>
                        <li class="list-group-item">
                            <div class="btn-group w-100" role="group" aria-label="Tamaño de la fuente">
                                <button id="font-sm-btn" type="button" class="btn border-success">Pequeño</button>
                                <button id="font-nm-btn" type="button" class="btn border-success">Normal</button>
                                <button id="font-lg-btn" type="button" class="btn border-success">Grande</button>
                            </div>
                        </li>

                        <h5>Atajos de teclado</h5>
                        <li class="list-group-item">
                            <button class="btn border-success w-100 mb-2" onclick="mostrarConfiguradorAtajos()">
                                Configurar Atajos
                            </button>
                            <button class="btn border-success w-100" onclick="mostrarAyudaAtajos()">
                                Ver Lista de Atajos (F1)
                            </button>
                        </li>

                        <h5>Idiomas</h5>
                        <li class="list-group-item dropdown w-100">
                            <a class="dropdown-toggle btn border-success" href="#" data-bs-toggle="dropdown">
                                Seleccionar idioma
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="./<%= actual_en %>" class="border-success">Inglés (EN)</a></li>
                                <li><a href="./<%= actual_es %>" class="border-success">Español (ES)</a></li>
                            </ul>
                        </li>

                        <% if(usuario) { %>
                            <!-- Mensaje para usuarios autenticados -->
                            <div class="alert alert-info small mb-0 mt-3">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Nota:</strong> Los cambios se guardan en tu cuenta.
                                Usa el botón "Guardar preferencias" para confirmar los cambios.
                            </div>
                            <% } else { %>
                                <!-- Mensaje para usuarios NO autenticados -->
                                <div class="alert alert-warning small mb-0 mt-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    <strong>Aviso:</strong> No has iniciado sesión. Las preferencias se guardan
                                    temporalmente en este navegador.
                                    <a href="/es-login" class="alert-link">Inicia sesión</a> para guardarlas
                                    permanentemente.
                                </div>
                                <% } %>
                    </ul>
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <div class="d-flex gap-2 flex-wrap w-100">
                        <% if(usuario) { %>
                            <button type="button" class="btn border-secondary" onclick="restaurarPreferenciasDefault()">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Restaurar por defecto
                            </button>

                            <button type="button" class="btn border-success ms-auto"
                                onclick="guardarPreferenciasPermanentes()">
                                <i class="bi bi-check-circle me-1"></i>
                                Guardar preferencias
                            </button>
                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>