<%- include('es-header', { title: typeof user !=='undefined' ? 'Editar Usuario' : 'Registrar Usuario' , estilos:
    ['style', 'forms' ], actual_es: '' , actual_en: '' }) %>

    <main>
        <section id="FormularioUsuario" class="contacto">
            <form id="registro-form-id" class="formularios"
                aria-label="<%= typeof user !== 'undefined' ? 'Formulario edición de usuario' : 'Formulario registro de usuario' %>"
                method="post"
                action="<%= typeof user !== 'undefined' ? '/user-edit/' + user.id_usuario : '/user-register' %>">

                <div class="mb-3">
                    <fieldset class="contact-fs">
                        <input type="hidden" name="idioma" value="español">
                        <% if (typeof user !=='undefined' ) { %>
                            <input type="hidden" id="id" name="id" value="<%= user.id_usuario %>">
                            <% } %>

                                <legend>
                                    <h2>
                                        <%= typeof user !=='undefined' ? 'Editar usuario' : 'Registrar nuevo usuario' %>
                                    </h2>
                                </legend>

                                <div class="row g-3">

                                    <!-- Nombre completo -->
                                    <div class="col-md-6">
                                        <label for="nombre" class="form-label">
                                            Nombre completo: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-person"></i>
                                            </span>
                                            <input type="text" id="nombre" name="nombre" class="form-control" required
                                                placeholder="Ej: Eustaquio Ramirez"
                                                value="<%= typeof user !== 'undefined' ? user.nombre : '' %>">
                                        </div>
                                        <span id="nombre-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Correo electrónico -->
                                    <div class="col-md-6">
                                        <label for="correo" class="form-label">
                                            Correo electrónico: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-envelope"></i>
                                            </span>
                                            <input type="email" id="correo" name="correo" class="form-control" required
                                                placeholder="Ej: usuario@example.com"
                                                value="<%= typeof user !== 'undefined' ? user.correo : '' %>">
                                        </div>
                                        <span id="correo-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Contraseña -->
                                    <div class="col-md-6">
                                        <label for="contraseña" class="form-label">
                                            Contraseña: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-lock"></i>
                                            </span>
                                            <input type="password" id="contraseña" name="password" class="form-control"
                                                <%=typeof user==='undefined' ? 'required' : '' %>
                                            placeholder="Ej: ASDFg7&A">
                                        </div>
                                        <span id="contraseña-error" class="error" aria-live="polite"></span>
                                        <% if (typeof user !=='undefined' ) { %>
                                            <small class="text-muted">Déjalo en blanco para mantener la contraseña
                                                actual</small>
                                            <% } %>
                                    </div>

                                    <!-- Teléfono -->
                                    <div class="col-md-6">
                                        <label for="telefono" class="form-label">
                                            Teléfono:
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-telephone"></i>
                                            </span>
                                            <input type="tel" id="telefono" name="telefono" class="form-control"
                                                placeholder="Ej: 666777888" pattern="^[0-9]{9}$"
                                                title="Debe contener 9 dígitos"
                                                value="<%= typeof user !== 'undefined' && user.telefono ? user.telefono : '' %>">
                                        </div>
                                        <span id="telefono-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Concesionario asignado -->
                                    <div class="col-md-6">
                                        <label for="concesionario" class="form-label">
                                            Concesionario asignado:
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-building"></i>
                                            </span>
                                            <select id="concesionario" name="concesionario" class="form-select">
                                                <option value="">Sin asignar</option>
                                                <% if (typeof concesionarios !=='undefined' ) { %>
                                                    <% concesionarios.forEach(c=> { %>
                                                        <option value="<%= c.id_concesionario %>" <%=typeof user
                                                            !=='undefined' && user.id_concesionario==c.id_concesionario
                                                            ? 'selected' : '' %>>
                                                            <%= c.id_concesionario %> : <%= c.nombre %> - <%= c.ciudad
                                                                        %>
                                                        </option>
                                                        <% }) %>
                                                            <% } %>
                                            </select>
                                        </div>
                                        <span id="concesionario-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Rol de usuario -->
                                    <div class="col-md-6">
                                        <label for="rol" class="form-label">
                                            Rol de usuario:
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-briefcase"></i>
                                            </span>
                                            <select id="rol" name="rol" class="form-select">
                                                <option value="">Sin asignar</option>
                                                <option value="empleado" <%=typeof user !=='undefined' &&
                                                    user.rol==='empleado' ? 'selected' : '' %>>
                                                    Empleado
                                                </option>
                                                <option value="admin" <%=typeof user !=='undefined' &&
                                                    user.rol==='admin' ? 'selected' : '' %>>
                                                    Administrador
                                                </option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Mensajes del servidor -->
                                    <% if (typeof success !=='undefined' && success) { %>
                                        <div class="alert alert-success" role="alert">
                                            <%= success %>
                                        </div>
                                        <% } %>

                                            <% if (typeof error !=='undefined' && error) { %>
                                                <div class="alert alert-danger" role="alert">
                                                    <%= error %>
                                                </div>
                                                <% } %>

                                                    <!-- Botones -->
                                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                                                        <a href="/es-admin" class="btn border-secondary px-4"
                                                            aria-label="Volver a administración">
                                                            <i class="bi bi-arrow-left me-2"></i> Volver
                                                        </a>
                                                        <button type="reset" class="btn border-secondary px-4"
                                                            aria-label="Limpiar formulario">
                                                            <i class="bi bi-arrow-clockwise me-2"></i> Limpiar datos
                                                        </button>
                                                        <button type="submit" class="btn border-success px-4"
                                                            aria-label="<%= typeof user !== 'undefined' ? 'Guardar cambios' : 'Registrar usuario' %>">
                                                            <i
                                                                class="bi bi-<%= typeof user !== 'undefined' ? 'save' : 'person' %> me-2"></i>
                                                            <%= typeof user !=='undefined' ? 'Guardar cambios'
                                                                : 'Registrar usuario' %>
                                                        </button>
                                                    </div>

                                </div>
                    </fieldset>
                </div>

            </form>
        </section>
    </main>

    <%- include('footer', {scripts: ['formulario-usuario']}) %>