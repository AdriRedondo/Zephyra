<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>

        <link rel="stylesheet" href="./styles/bootstrap.min.css">
        <% estilos.forEach(estilo=> { %>
        <link rel="stylesheet" href="./styles/<%= estilo %>.css">
        <% }) %>
    </head>

    <body>
        <header>
            <nav class="navbar navbar-expand navbar-dark" id="custom-navbar">
                <div class="container-fluid ">
                    <button class="navbar-toggler ms-3" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="logo-container">
                        <a class="navbar-brand div-logo" href="/en-home">
                            <img src="/images/icono-logo.png" alt="Logo Zephyra"
                                title="Logo Zephyra" width="100">
                            <h1 class="zephyra">ZEPHYRA</h1>
                        </a>
                    </div>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/en-home"
                                    accesskey="i">Home</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/en-vehicles"
                                    accesskey="v">Vehicles</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/en-bookings"
                                    accesskey="r">Book Vehicle</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/en-contact"
                                    accesskey="c">Contact</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav ms-auto">
                            <% if(usuario) {%>
                            <li class="nav-item me-3">
                                <a class="nav-link" href="/en-history"
                                    accesskey="h">My Bookings</a>
                            </li>
                            <% } %>
                            <% if(!usuario) {%>
                            <li class="nav-item me-3">
                                <a class="nav-link pt-auto" href="/en-login"
                                    accesskey="l">Login</a>
                            </li>
                            <% } %>
                            <li class="nav-item me-3">
                                <a role="button" class="nav-link pt-auto"
                                    accesskey="a" data-bs-toggle="modal"
                                    data-bs-target="#accessModal">Accessibility</a>
                            </li>
                            <% if(usuario && usuario.rol==='admin' ) {%>
                            <li class="nav-item me-3">
                                <a class="nav-link pt-auto" href="/en-admin"
                                    accesskey="m">Admin</a>
                            </li>
                            <% } %>
                            <% if(usuario) {%>
                            <li class="nav-item me-3">
                                <a class="menu-icon nav-link" href="/en-logout"
                                    accesskey="g">
                                    <i class="bi bi-box-arrow-left"></i>
                                </a>
                            </li>
                            <% }%>
                            <% if(usuario) {%>
                            <li class="nav-item">
                                <a class="menu-icon nav-link" href="/en-profile"
                                    accesskey="p">
                                    <i
                                        class="profile-icon bi bi-person-circle"></i>
                                </a>
                            </li>
                            <% } %>
                        </div>

                    </div>

                </nav>

            </header>
            <div class="modal fade" id="accessModal" tabindex="-1"
                aria-labelledby="accessModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5"
                                id="accessModalLabel">Accessibility</h1>
                            <button type="button" class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <ul class="list-group">
                                <h5>Contrast</h5>
                                <li
                                    class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="btn-group w-100">
                                        <button id="light-btn"
                                            class="btn border-success">Light</button>
                                        <button id="dark-btn"
                                            class="btn border-success">Dark</button>
                                    </div>
                                </li>
                                <li class="list-group-item">
                                    <button
                                        class="btn border-success w-100">Colorblind
                                        Palette</button>
                                </li>
                                <h5>Font Size</h5>
                                <li class="list-group-item">
                                    <div class="btn-group w-100" role="group"
                                        aria-label="Font size">
                                        <button id="font-sm-btn" type="button"
                                            class="btn border-success">Small</button>
                                        <button id="font-nm-btn" type="button"
                                            class="btn border-success">Normal</button>
                                        <button id="font-lg-btn" type="button"
                                            class="btn border-success">Large</button>
                                    </div>
                                </li>
                                <h5>Keyboard Shortcuts</h5>
                                <li class="list-group-item">
                                    <ul name="shortcuts" id="shortcuts"
                                        class="my-3">
                                        <li> Alt + I → Home Page</li>
                                        <li> Alt + V → Available Vehicles</li>
                                        <li> Alt + R → Reserve a Vehicle</li>
                                        <li> Alt + C → Contact Us</li>
                                        <li> Alt + H → Booking History</li>
                                        <li> Alt + L → Login Page</li>
                                        <li> Alt + A → Accessibility
                                            Options</li>
                                        <li> Alt + M → Admin Management</li>
                                        <li> Alt + G → Log out</li>
                                        <li> Alt + P → User Profile</li>
                                    </ul>
                                </li>
                                <h5>Languages</h5>
                                <li class="list-group-item dropdown w-100">
                                    <a class="dropdown-toggle border-success"
                                        href="#"
                                        data-bs-toggle="dropdown">Select
                                        language</a>
                                    <ul class="dropdown-menu">
                                        <li><a href="./<%= actual_en %>"
                                                class="border-success">English
                                                (EN)</a></li>
                                        <li><a href="./<%= actual_es %>"
                                                class="border-success">Spanish
                                                (ES)</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </body>

    </html>