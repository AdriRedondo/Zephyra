<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="./styles/bootstrap.min.css">
    <% estilos.forEach(estilo=> { %>
        <link rel="stylesheet" href="./styles/<%= estilo %>.css">
        <% }) %>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <button class="navbar-toggler ms-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand div-logo" href="/en-home.ejs">
                    <img src="./images/icono-logo.png" alt="Zephyra Logo" title="Zephyra Logo" width="100">
                    <h1 class="zephyra">ZEPHYRA</h1>
                </a>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ">
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="en-home.ejs" accesskey="h">Home</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="en-vehicles.ejs" accesskey="v">Vehicles</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="en-bookings.ejs" accesskey="b">Bookings</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="en-contact.ejs" accesskey="c">Contact</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link elem-menu p-2" href="en-sign-in.ejs" accesskey="s">Sign in</a>
                        </li>
                        <li class="nav-item dropdown me-2">
                            <a class="dropdown-toggle nav-link elem-menu" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                Change Language
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="./<%= actual_es %>" lang="en" title="Switch to Spanish"
                                        class="dropdown-item">
                                        Spanish (ES)
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>
</body>

</html>