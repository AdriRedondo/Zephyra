<%- include('es-header', { title: typeof concesionario !=='undefined' ? 'Editar Concesionario'
    : 'Registrar Concesionario' , estilos: ['style', 'forms' ], actual_es: '' , actual_en: '' , extraCSS:
    ['https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'] }) %>

    <main>
        <section id="EditarConcesionario" class="contacto">
            <form id="dealer-form-id" class="formularios"
                aria-label="<%= typeof concesionario !== 'undefined' ? 'Formulario edición de concesionario' : 'Formulario registro de concesionario' %>"
                method="post"
                action="<%= typeof concesionario !== 'undefined' ? '/dealer-edit/' + concesionario.id_concesionario : '/dealer-register' %>">

                <div class="mb-3">
                    <fieldset class="contact-fs">
                        <input type="hidden" name="idioma" value="español">
                        <% if (typeof concesionario !=='undefined' ) { %>
                            <input type="hidden" id="id" name="id" value="<%= concesionario.id_concesionario %>">
                            <% } %>
                                <legend>
                                    <h2>
                                        <%= typeof concesionario !=='undefined' ? 'Editar concesionario'
                                            : 'Registrar nuevo concesionario' %>
                                    </h2>
                                </legend>

                                <div class="row g-3">

                                    <!-- Nombre -->
                                    <div class="col-md-6">
                                        <label for="dealer-nombre" class="form-label">
                                            Nombre: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-building"></i>
                                            </span>
                                            <input type="text" id="dealer-nombre" name="nombre" class="form-control"
                                                required placeholder="Ej: Zephyra Madrid Centro"
                                                value="<%= typeof concesionario !== 'undefined' ? concesionario.nombre : '' %>">
                                        </div>
                                        <span id="dealer-nombre-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Ciudad -->
                                    <div class="col-md-6">
                                        <label for="dealer-ciudad" class="form-label">
                                            Ciudad: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-geo-alt"></i>
                                            </span>
                                            <input type="text" id="dealer-ciudad" name="ciudad" class="form-control"
                                                required placeholder="Ej: Madrid"
                                                value="<%= typeof concesionario !== 'undefined' ? concesionario.ciudad : '' %>">
                                        </div>
                                        <span id="dealer-ciudad-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Dirección -->
                                    <div class="col-md-6">
                                        <label for="dealer-direccion" class="form-label">
                                            Dirección: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-geo"></i>
                                            </span>
                                            <input type="text" id="dealer-direccion" name="direccion"
                                                class="form-control" required placeholder="Ej: C/Larios de la Rosa, 23"
                                                value="<%= typeof concesionario !== 'undefined' ? concesionario.direccion : '' %>">
                                        </div>
                                        <span id="dealer-direccion-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Teléfono -->
                                    <div class="col-md-6">
                                        <label for="dealer-telefono" class="form-label">
                                            Teléfono: <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-telephone"></i>
                                            </span>
                                            <input type="tel" id="dealer-telefono" name="telefono" class="form-control"
                                                pattern="^[0-9]{9}$" title="Debe contener 9 dígitos" required
                                                placeholder="Ej: 666777888"
                                                value="<%= typeof concesionario !== 'undefined' ? concesionario.telefono_contacto : '' %>">
                                        </div>
                                        <span id="dealer-telefono-error" class="error" aria-live="polite"></span>
                                    </div>

                                    <!-- Coordenadas (se rellenan automáticamente al geocodificar) -->
                                    <input type="hidden" id="dealer-latitud" name="latitud"
                                        value="<%= typeof concesionario !== 'undefined' ? concesionario.latitud || '' : '' %>">
                                    <input type="hidden" id="dealer-longitud" name="longitud"
                                        value="<%= typeof concesionario !== 'undefined' ? concesionario.longitud || '' : '' %>">

                                    <!-- Mapa picker -->
                                    <div class="col-md-12">
                                        <label class="form-label">Ubicación en el mapa: <span
                                                class="text-muted small">(haz clic para ajustar)</span></label>
                                        <div id="mapa-picker"
                                            style="height: 300px; border-radius: 8px; border: 1px solid #ced4da;"></div>
                                        <span id="dealer-mapa-info" class="text-muted small mt-1 d-block">Introduce la
                                            dirección y ciudad para localizar automáticamente</span>
                                    </div>

                                    <!-- Mensajes del servidor -->
                                    <% if (typeof success !=='undefined' && success) { %>
                                        <div class="alert alert-success">
                                            <%= success %>
                                        </div>
                                        <% } %>

                                            <% if (typeof error !=='undefined' && error) { %>
                                                <div class="alert alert-danger">
                                                    <%= error %>
                                                </div>
                                                <% } %>

                                                    <!-- Botones -->
                                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                                                        <button type="reset" class="btn border-secondary px-4"
                                                            aria-label="Limpiar formulario">
                                                            <i class="bi bi-arrow-clockwise me-2"></i> Limpiar datos
                                                        </button>
                                                        <button type="submit" class="btn border-success px-4"
                                                            aria-label="<%= typeof concesionario !== 'undefined' ? 'Guardar cambios' : 'Registrar concesionario' %>">
                                                            <i
                                                                class="bi bi-<%= typeof concesionario !== 'undefined' ? 'save' : 'building' %> me-2"></i>
                                                            <%= typeof concesionario !=='undefined' ? 'Guardar cambios'
                                                                : 'Registrar concesionario' %>
                                                        </button>
                                                    </div>

                                </div>
                    </fieldset>
                </div>

            </form>
        </section>
    </main>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <%- include('footer', {scripts: ['formulario-concesionario']}) %>