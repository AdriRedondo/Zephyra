<%- include('en-header', { title: 'Available vehicles' , estilos: ['style',
'vehiculos' ], actual_es: 'es-vehiculos' ,
actual_en: 'en-vehicles' }) %>
<main class="vehiculos-container">

    <aside>
        <div class="row filtros">

            <h3>Filters</h3>

            <form action="/en-vehicles" method="get">

                <label>Make:</label>
                <select name="make" class="form-select mb-3">
                    <option value>All</option>
                    <% const marcas=[...new Set(vehiculos.map(v=> v.marca))];
                    marcas.forEach(m => {
                    %>
                    <option value="<%= m %>" <%=filtros && filtros.marca===m ?
                        'selected' : '' %>>
                        <%= m %>
                    </option>
                    <% }) %>
                </select>

                <label>Model:</label>
                <select name="model" class="form-select mb-3">
                    <option value>All</option>
                    <% const modelos=[...new Set(vehiculos.map(v=> v.modelo))];
                    modelos.forEach(mod => {
                    %>
                    <option value="<%= mod %>" <%=filtros &&
                        filtros.modelo===mod ? 'selected' : '' %>>
                        <%= mod %>
                    </option>
                    <% }) %>
                </select>

                <label>Number of Seats:</label>
                <select name="seats" class="form-select mb-3">
                    <option value>All</option>
                    <% const plazas=[...new Set(vehiculos.map(v=>
                    v.numero_plazas))].sort((a, b) => a - b);
                    plazas.forEach(p => {
                    %>
                    <option value="<%= p %>" <%=filtros && filtros.plazas==p ?
                        'selected' : '' %>>
                        <%= p %> seats
                    </option>
                    <% }) %>
                </select>

                <label>Dealership:</label>
                <select name="dealership" class="form-select mb-3">
                    <option value>All</option>
                    <% const concesionarios=[...new Set(vehiculos.map(v=>
                    v.nombre_concesionario).filter(Boolean))].sort();
                    concesionarios.forEach(c => {
                    %>
                    <option value="<%= c %>" <%=filtros &&
                        filtros.concesionario===c ? 'selected' : '' %>>
                        <%= c %>
                    </option>
                    <% }) %>
                </select>

                <label>Status:</label>
                <select name="status" class="form-select mb-3">
                    <option value>All</option>
                    <% const estados=['available', 'reserved' , 'maintenance' ];
                    estados.forEach(e=> {
                    %>
                    <option value="<%= e %>" <%=filtros && filtros.estado===e ?
                        'selected' : '' %>>
                        <%= e %>
                    </option>
                    <% }) %>
                </select>

                <button type="submit" class="btn border-success w-100">Apply
                    Filters</button>

            </form>

        </div>
        <% if(usuario && usuario.rol==='admin' ){ %>
        <div class="row filtros mt-3">
            <a type="button" class="btn border-success"
                href="/en-vehicles/new-vehicle">New Vehicle</a>
        </div>
        <% } %>
    </aside>

    <section class="col-lg-12">
        <% if (vehiculosFiltrados && vehiculosFiltrados.length>0) { %>
        <div
            class="row row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            <% vehiculosFiltrados.forEach(vehiculo=> { %>
            <% if( usuario || ( !usuario && vehiculo.estado==='available' )) {
            %>
            <div class="col">
                <div class="card h-100">
                    <img src="/en-vehicles/image/<%= vehiculo.id_vehiculo %>"
                        class="vehicle-img card-img-top"
                        alt="<%= vehiculo.marca %> <%= vehiculo.modelo %>">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <%= vehiculo.marca %>
                            <%= vehiculo.modelo %>
                        </h5>
                        <p class="card-text"><strong>Status:</strong>
                            <%= vehiculo.estado %>
                        </p>

                        <div class="d-flex gap-2 mt-3">
                            <a type="button"
                                href="/en-vehicles/<%= vehiculo.id_vehiculo %>"
                                class="btn border-success mt-auto w-100">
                                Details
                            </a>

                            <% if(usuario && usuario.rol==='admin' ) { %>
                            <a class="btn border-secondary mt-auto"
                                href="/en-vehicles/<%= vehiculo.id_vehiculo %>/edit">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form
                                action="/en-vehicles/<%= vehiculo.id_vehiculo %>/delete"
                                method="post" class="flex-fill"
                                onsubmit="return confirm('Are you sure you want to delete this vehicle?');">
                                <button class="btn border-danger" type="submit">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                            <% } %>
                        </div>

                    </div>
                </div>
            </div>
            <% } %>

            <% }) %>
        </div>
        <% } else { %>
        <div class="card text-center border-0 shadow-sm p-4">
            <div class="card-body">
                <h5 class="card-title">No Vehicles Available</h5>
                <p class="card-text">No vehicles were found matching these
                    filters.
                    <br>Try changing the criteria.
                </p>
            </div>
        </div>
        <% } %>
    </section>
</main>
<%- include('footer', {scripts: []}) -%>