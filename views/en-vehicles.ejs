<%- include('en-header', { title: 'Available vehicles' , estilos: ['style',
'vehiculos' ], actual_es: 'es-vehiculos' ,
actual_en: 'en-vehicles' }) %>
<main class="vehiculos-container">

    <aside>
        <div class="row filtros">

            <h3>Filters</h3>

            <form action="/en-vehicles" method="get">

                <label>Minimum Range (km):</label>
                <input type="number" name="autonomia_min" class="form-control mb-3" value="0" min="0">

                <label>Number of Seats:</label>
                <select name="plazas" class="form-select mb-3">
                    <option value>All</option>
                    <% const plazas=[...new Set(vehiculos.map(v=>
                    v.numero_plazas))].sort((a, b) => a - b);
                    plazas.forEach(p => {
                    %>
                    <option value="<%= p %>">
                        <%= p %> seats
                    </option>
                    <% }) %>
                </select>

                <label>Color:</label>
                <select name="color" class="form-select mb-3">
                    <option value>All</option>
                    <% const colores=[...new Set(vehiculos.map(v=>
                    v.color).filter(Boolean))].sort();
                    colores.forEach(c => {
                    %>
                    <option value="<%= c %>">
                        <%= c %>
                    </option>
                    <% }) %>
                </select>

                <label>Make:</label>
                <select name="marca" class="form-select mb-3">
                    <option value>All</option>
                    <% const marcas=[...new Set(vehiculos.map(v=> v.marca))];
                    marcas.forEach(m => {
                    %>
                    <option value="<%= m %>">
                        <%= m %>
                    </option>
                    <% }) %>
                </select>

                <label>Model:</label>
                <select name="modelo" class="form-select mb-3">
                    <option value>All</option>
                    <% const modelos=[...new Set(vehiculos.map(v=> v.modelo))];
                    modelos.forEach(mod => {
                    %>
                    <option value="<%= mod %>">
                        <%= mod %>
                    </option>
                    <% }) %>
                </select>

                <label>Dealership:</label>
                <select name="concesionario" class="form-select mb-3">
                    <option value>All</option>
                    <% const concesionarios=[...new Set(vehiculos.map(v=>
                    v.nombre_concesionario).filter(Boolean))].sort();
                    concesionarios.forEach(c => {
                    %>
                    <option value="<%= c %>">
                        <%= c %>
                    </option>
                    <% }) %>
                </select>

                <label>Status:</label>
                <select name="estado" class="form-select mb-3">
                    <option value>All</option>
                    <% const estados=['available', 'reserved' , 'maintenance' ];
                    estados.forEach(e=> {
                    %>
                    <option value="<%= e %>">
                        <%= e %>
                    </option>
                    <% }) %>
                </select>

            </form>

        </div>
        <% if(usuario && usuario.rol==='admin' ){ %>
        <div class="row filtros mt-3">
            <a type="button" class="btn border-success"
                href="/en-vehicles/new-vehicle">New Vehicle</a>
        </div>
        <% } %>
    </aside>

    <section class="col-lg-12">
        <div class="contenedor-vehiculos row row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            <!-- Esto se rellena dinámicamente con el js de ajax-->
        </div>
    </section>
</main>
<%- include('footer', {scripts: ['vehiculos-ajax']}) -%>