<% if (lang==='es' ) { %>
    <%- include('es-header', { title: error, estilos: ['style', 'errors' ], actual_es: 'errors' , actual_en: 'errors'
        })%>
        <% } else { %>
            <%- include('en-header', { title: error, estilos: ['style', 'errors' ], actual_es: 'errors' ,
                actual_en: 'errors' }) %>
                <% } %>
                    <main>
                        <section id="error">
                            <div class="row">
                                <div class="col-6">
                                    <div class="container-fluid error-container">
                                        <div class="row">
                                            <h2 class="error-title mb-3">
                                                <%= error%>
                                            </h2>
                                            <h3 class="mb-3">
                                                <%= texto1 %>
                                            </h3>
                                            <p class="mb-3">
                                                <%= texto2 %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 div-visual-content">
                                    <img src="/images/coche-electrico2.png" alt="Icono de coche eléctrico"
                                        title="Coche eléctrico">
                                </div>
                            </div>
                        </section>
                    </main>
                    <%- include('footer', {scripts: []}) -%>