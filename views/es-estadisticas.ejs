<!-- Tarjetas de resumen -->
<div class="row mb-4" id="resumen-cards">
    <div class="col-md-3 mb-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">Total Reservas</h5>
                <p class="card-text display-4 text-success fw-bold" id="total-reservas">-</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">Total Vehículos</h5>
                <p class="card-text display-4 text-success fw-bold" id="total-vehiculos">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">Concesionarios</h5>
                <p class="card-text display-4 text-success fw-bold" id="total-concesionarios">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">Usuarios</h5>
                <p class="card-text display-4 text-success fw-bold" id="total-usuarios">-</p>
            </div>
        </div>
    </div>
</div>

<!-- Reservas por concesionario -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="mb-3"><i class="bi bi-building text-success"></i> Reservas por Concesionario</h5>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Concesionario</th>
                        <th>Ciudad</th>
                        <th>Total Reservas</th>
                    </tr>
                </thead>
                <tbody id="reservas-concesionario">
                    <tr>
                        <td colspan="3" class="text-center">Cargando...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Top 10 vehículos más usados -->
<div class="row">
    <div class="col-12">

        <h5 class="mb-3"><i class="bi bi-car-front-fill text-success"></i> Vehículos Más Reservados</h5>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th></th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Matrícula</th>
                        <th>Total Reservas</th>
                    </tr>
                </thead>
                <tbody id="top-vehiculos">
                    <tr>
                        <td colspan="5" class="text-center">Cargando...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Kilómetros totales e Incidencias -->
<div class="row mb-4 mt-4">
    <div class="col-md-6 mb-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">
                    <i class="bi bi-speedometer2 text-success"></i> Kilómetros Totales Recorridos
                </h5>
                <p class="card-text display-4 text-success fw-bold" id="total-kms">-</p>
                <small class="text-muted">en reservas finalizadas</small>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">
                    <i class="bi bi-exclamation-triangle text-warning"></i> Incidencias Reportadas
                </h5>
                <p class="card-text display-4 text-warning fw-bold" id="total-incidencias">-</p>
                <small class="text-muted">reservas con incidencias</small>
            </div>
        </div>
    </div>
</div>

<!-- Franjas horarias -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="mb-3">
            <i class="bi bi-clock text-success"></i> Reservas por Franja Horaria
        </h5>
        <div id="franjas-horarias">
            <p class="text-muted">Cargando...</p>
        </div>
    </div>
</div>