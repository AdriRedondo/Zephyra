<%- include('es-header', { title: 'Formulario de contacto' , estilos: ['style', 'form-contact' ],
    actual_es: 'es-contacto' , actual_en: 'en-contact' }) %>
    <main>
        <section id="Contacto" class="contacto">
            <h2>Contacto</h2>
            <form id="contacto-form-id" class="contacto-form" aria-label="Formulario de contacto" method="post"
                action="/submit_contact">
                <div class="mb-3">
                    <fieldset class="contact-fs" name="contacto">
                        <input type="hidden" name="idioma" value="español">
                        <legend>Datos de contacto</legend>
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre:
                            </label>
                            <input type="text" id="nombre" name="nombre" class="form-control"
                                placeholder="Ej: Eustaquio Ramirez">
                            <span id="nombre-error" class="error" aria-live="polite"></span>
                        </div>
                        <div class="mb-3">
                            <label for="correo" class="form-label">Email:
                            </label>
                            <input type="email" id="correo" name="correo" class="form-control"
                                placeholder="Ej: eusta03@ucm.es">
                            <span id="correo-error" class="error" aria-live="polite"></span>
                        </div>
                        <div class="mb-3">
                            <label for="mensaje" class="form-label">Mensaje:
                            </label>
                            <input type="text" id="mensaje" name="mensaje" class="form-control"
                                placeholder="Ej: Patata">
                            <span id="mensaje-error" class="error" aria-live="polite"></span>
                        </div>

                        <button type="submit" class="btn btn-success" aria-label="Enviar formulario">Enviar</button>
                        <button type="reset" class="btn btn-secondary" aria-label="Limpiar formulario">Limpiar</button>
                    </fieldset>
                </div>
            </form>
        </section>

    </main>
    <%- include('footer', {scripts: ['formulario-contacto']}) -%>